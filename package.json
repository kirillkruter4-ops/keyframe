{
  "name": "keyframe",
  "version": "0.0.1",
  "description": "Keyframe — modern open-source media player for Windows",
  "main": "./out/main/index.js",
  "author": "kirillkruter4-ops",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "fetch-mpv": "node scripts/fetch-mpv.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:local": "electron-vite build && node scripts/dist-local.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
